# Copy this file to .env and fill in your own API key locally.
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-flash
WHISPER_MODEL=base

# Only for local HTTP development. Do NOT enable on an HTTPS deployment.
APP_INSECURE=0
# Optional fixed strong random signing secret; otherwise persisted in .secret_key.
# SECRET_KEY=replace_with_a_strong_random_secret
