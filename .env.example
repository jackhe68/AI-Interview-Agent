# Copy this file to .env and fill in your own API key locally.
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-flash
WHISPER_MODEL=base

# Only for local HTTP development. Do NOT enable on an HTTPS deployment.
APP_INSECURE=0
# Optional fixed strong random signing secret; otherwise persisted in .secret_key.
# SECRET_KEY=replace_with_a_strong_random_secret

# Public trial: provider calls, including questions/reports/advice; reset at UTC+9 midnight.
TRIAL_GUEST_AI_DAILY=100
TRIAL_ACCOUNT_AI_DAILY=1000
TRIAL_GUEST_AI_PER_MINUTE=12
TRIAL_ACCOUNT_AI_PER_MINUTE=60
TRIAL_IP_AI_DAILY=10000
TRIAL_IP_AI_PER_MINUTE=240
# Concurrency ceiling is not a measured hosting capacity; lower it for smaller hosts.
TRIAL_AI_CONCURRENT=1000
